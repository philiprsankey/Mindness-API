PORT=3000
DATABASE_PATH=./mindness.db

# Auth
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=7d

# Email (Resend) — verification codes log to console when RESEND_API_KEY is unset
RESEND_API_KEY=
RESEND_FROM_EMAIL=Mindness <info@mindness.co.uk>

# Google OAuth — Web client ID verifies mobile ID tokens
GOOGLE_CLIENT_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_VOICE_FEMALE=marin
OPENAI_REALTIME_VOICE_MALE=echo
OPENAI_REALTIME_VOICE_PREMIUM=marin

# ElevenLabs (Companion+ premium voice accents)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional overrides — defaults use curated premade voices per gender + origin
# ELEVENLABS_VOICE_BRITISH_FEMALE=
# ELEVENLABS_VOICE_BRITISH_MALE=
# ELEVENLABS_VOICE_AMERICAN_FEMALE=
# ELEVENLABS_VOICE_AMERICAN_MALE=

# Simli (Companion+ animated voice avatars — f1/m1 presets)
SIMLI_API_KEY=

# App
APP_NAME=Mindness
SUPPORT_EMAIL=info@mindness.co.uk
UPLOADS_PATH=./uploads
FREE_DAILY_MESSAGES=10

# Dev only — override every user's effective tier (free | companion | companion_plus)
# DEV_SUBSCRIPTION_TIER=companion_plus
